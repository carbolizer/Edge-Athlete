limit_req_zone $binary_remote_addr zone=gateway_ingest:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=staff_auth:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=hosted_control_plane:10m rate=10r/s;
access_log off;
error_log /dev/stderr crit;

upstream vps_django {
    server vps-django:8000;
}

upstream vps_react {
    server vps-react:80;
}

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name ${VPS_DOMAIN};

    # Never redirect a request that may carry a credential or event body.
    if ($request_method !~ ^(GET|HEAD)$) {
        return 405;
    }

    return 308 https://${VPS_DOMAIN}$request_uri;
}

server {
    listen 80;
    server_name ${BLE_LAB_DOMAIN};

    if ($request_method !~ ^(GET|HEAD)$) {
        return 405;
    }

    return 308 https://${BLE_LAB_DOMAIN}$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${VPS_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${VPS_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${VPS_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "bluetooth=(), camera=(), geolocation=(), microphone=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self'" always;

    # Django also emits these headers. Hide its copies so every public response
    # has one policy, owned by this TLS boundary, rather than conflicting values.
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;

    location = /api/gateway/v1/events/ {
        client_max_body_size 256k;
        limit_req zone=gateway_ingest burst=20 nodelay;
        limit_req_status 429;

        if ($args) {
            return 400;
        }

        # Gateway logs must not retain addresses, credentials, IDs, or payloads.
        proxy_pass http://vps_django;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
    }

    location = /api/health/ {
        proxy_pass http://vps_django;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
    }

    location = /api/gateways/diagnostics/ {
        proxy_pass http://vps_django;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
    }

    location ~ ^/api/auth/(login|refresh)/$ {
        limit_req zone=staff_auth burst=5 nodelay;
        limit_req_status 429;
        client_max_body_size 16k;

        proxy_pass http://vps_django;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
    }

    location ~ ^/api/rack/v1/(csrf|status)/$ {
        limit_req zone=hosted_control_plane burst=20 nodelay;
        limit_req_status 429;
        if ($request_method != GET) {
            return 405;
        }
        if ($args) {
            return 400;
        }
        client_max_body_size 16k;
        proxy_pass http://vps_django;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Edge-Client-Address $remote_addr;
    }

    location ~ ^/api/rack/v1/(endpoint-pairings(?:/status)?|helper-pairings(?:/status)?|helper-launch-intents(?:/inspect)?)/$ {
        limit_req zone=hosted_control_plane burst=20 nodelay;
        limit_req_status 429;
        if ($request_method != POST) {
            return 405;
        }
        if ($args) {
            return 400;
        }
        client_max_body_size 16k;
        proxy_pass http://vps_django;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Edge-Client-Address $remote_addr;
    }

    location ~ ^/api/coach/v1/(rack-endpoint-pairings/claim|rack-helper-pairings/confirm)/$ {
        limit_req zone=hosted_control_plane burst=20 nodelay;
        limit_req_status 429;
        if ($request_method != POST) {
            return 405;
        }
        if ($args) {
            return 400;
        }
        client_max_body_size 16k;
        proxy_pass http://vps_django;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Edge-Client-Address $remote_addr;
    }

    location = /api/coach/v1/training-groups/ {
        limit_req zone=hosted_control_plane burst=20 nodelay;
        limit_req_status 429;
        if ($request_method != GET) {
            return 405;
        }
        if ($args) {
            return 400;
        }
        client_max_body_size 16k;
        proxy_pass http://vps_django;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Edge-Client-Address $remote_addr;
    }

    location ~ ^/api/rack-helper/v1/(pairings/(claim|status|activate)|status|launch-intents/consume)/$ {
        limit_req zone=hosted_control_plane burst=20 nodelay;
        limit_req_status 429;
        if ($request_method != POST) {
            return 405;
        }
        if ($args) {
            return 400;
        }
        client_max_body_size 16k;
        proxy_pass http://vps_django;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Edge-Client-Address $remote_addr;
    }

    location /api/ {
        return 404;
    }

    location ^~ /admin/ {
        return 404;
    }

    location ^~ /static/admin/ {
        return 404;
    }

    location ^~ /static/rest_framework/ {
        return 404;
    }

    location = /ble-lab.html {
        return 404;
    }

    location / {
        proxy_pass http://vps_react;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${BLE_LAB_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${BLE_LAB_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${BLE_LAB_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:BLELabTLS:2m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src 'none'; frame-ancestors 'none'; img-src 'none'; object-src 'none'; worker-src 'none'" always;
    add_header Permissions-Policy "bluetooth=(self), camera=(), geolocation=(), microphone=()" always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;

    location = / {
        proxy_pass http://vps_react/ble-lab.html;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
    }

    location ^~ /assets/ {
        proxy_pass http://vps_react;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
    }

    location / {
        return 404;
    }
}
