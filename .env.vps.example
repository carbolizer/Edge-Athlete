# Copy to .env.vps and replace every placeholder before running the VPS profile.
# This template contains no deployable credentials.

COMPOSE_PROJECT_NAME=edgeathlete-vps
VPS_DOMAIN=<public-dns-name>
BLE_LAB_DOMAIN=<ble-lab-dns-name>
VPS_CERTBOT_DIR=<absolute-path-to-certbot-state>

SECRET_KEY=<generate-a-unique-django-secret>
RACK_CONTROL_PLANE_KEY=<generate-an-independent-control-plane-secret>
ALLOWED_HOSTS=<public-dns-name>
CSRF_TRUSTED_ORIGINS=https://<public-dns-name>

POSTGRES_DB=<database-name>
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<generate-a-unique-database-password>
