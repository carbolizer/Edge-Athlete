#!/usr/bin/env bash
#
# pre-commit — keep the schema docs honest without anyone having to remember.
#
# WHAT IT DOES
# If a commit touches the database models or a migration, this refreshes the
# table-by-table schema in docs/journal/database.md and adds the result to the same
# commit. The docs and the schema therefore change together, in one commit, always.
#
# WHAT IT DOES NOT TOUCH
# Only the column tables are regenerated. Every word anyone wrote around them — what
# the table is for, why it exists, the decisions — is preserved. See
# docs/refresh-schema.py for how that is fenced off.
#
# WHY HERE AND NOT IN DOCKER
# The obvious-looking place is `docker compose`, when migrations run. It is the wrong
# place: the django container has no view of this repo (its source is baked in at
# build time), `docker compose` also runs on the base station in the gym where nobody
# reads docs, and having a container write into a tracked file is exactly the bug that
# used to make base-station updates fail with a merge conflict. The commit is the
# moment the schema actually changes, and it happens on a machine where the docs live.
#
# TO SKIP IT once:  git commit --no-verify
#
set -euo pipefail

REPO="$(git rev-parse --show-toplevel)"
REFRESH="$REPO/docs/refresh-schema.py"
DOC="docs/journal/database.md"

# Only act when this commit actually changes the schema.
if ! git diff --cached --name-only | grep -qE "django/event_handler/(models\.py|migrations/)"; then
    exit 0
fi

[ -x "$REFRESH" ] || exit 0   # docs tooling not present in this checkout; not an error

echo "[docs] schema changed — refreshing $DOC"

# Refresh, and let the output through so a NEW table is announced rather than slipped
# silently into the commit.
if ! output=$(python3 "$REFRESH" 2>&1); then
    echo "[docs] refresh failed:"
    echo "$output"
    echo "[docs] commit stopped. Fix the above, or use --no-verify to skip."
    exit 1
fi
echo "$output" | sed 's/^/[docs] /'

# Stage it only if it actually changed, so a no-op commit stays a no-op.
if ! git diff --quiet -- "$DOC"; then
    git add "$DOC"
    echo "[docs] staged $DOC"
fi

# A brand-new table arrives with empty prose slots. Say so loudly — the schema is
# right, but nobody has explained the table yet.
if echo "$output" | grep -q "NEW tables"; then
    echo "[docs] ^ new table(s) have empty 'Why it exists' / 'Decisions' slots."
    echo "[docs]   The commit is fine; please fill them in."
fi

exit 0
