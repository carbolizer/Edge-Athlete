#pragma once

// Copy this file to secrets.h. Never commit secrets.h.
#define WIFI_SSID "your-2.4-ghz-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Use the base station's address on the same trusted LAN or private AP.
#define MQTT_HOST "192.168.4.1"
#define MQTT_PORT 1883

// Internet-connected development networks can use pool.ntp.org. The offline
// Edge Athlete AP must provide a reachable local NTP server.
#define NTP_SERVER "pool.ntp.org"

// Development only: use USB serial instead of Wi-Fi/MQTT.
#define USB_BRIDGE_ENABLED 0
